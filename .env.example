# Export these variables in your shell before starting the server.
MONGODB_URI=mongodb://127.0.0.1:27017/mydatabase
PORT=3000
# Required in production. Use a long, random value.
SESSION_SECRET=replace-with-a-random-secret
# For Colima: export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
# Otherwise the judge uses the active Docker CLI context.
JUDGE_CONCURRENCY=2
# Optional: must be shared with your local Docker VM.
# JUDGE_TEMP_DIR=/absolute/path/to/shared/judge-tmp
